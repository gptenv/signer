{
  "name": "@gptenv/signer",
  "version": "0.1.0",
  "description": "Offline Ethereum signing for Cloudflare Workers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@cloudflare/workers-types": "5.20261121.1",
    "cf": "1.0.0-rc.2",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
